<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- imaudio's IMAudioService is guarded by this normal-protection permission (defined by imaudio).
         Any app that declares it can bind — this is what makes cross-app binding possible. -->
    <uses-permission android:name="com.immotors.imaudio_service.permission.BIND_SERVICE" />
    <!-- Media mechanism (切歌): control other apps' media sessions via MediaController. -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
    <uses-permission android:name="com.banma.carcontrolservice.ACCESS_CARCONTROL_SERVICE" />

    <!-- Android 11+ package visibility: required to resolve/bind imaudio's service from a different app. -->
    <queries>
        <package android:name="com.immotors.imaudio" />
    </queries>

    <application
        android:label="Bridge Executor"
        android:allowBackup="false">

        <!-- Standalone per-call executor: binds the TARGET app's IMAudioService CROSS-APP (the
             generalization crux), dispatches by external registry.json, writes result.json, finishes.
             Vanilla solid theme — the legacy Theme.Translucent broke onCreate on this SDK-36 car. -->
        <activity
            android:name=".ExecutorActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
    </application>

</manifest>
