{
  "_doc": "CarControl (com.immotors.carcontrol) intent 跳转能力面 — Form 1 startActivity, fire-and-forget 打开空调/座椅/灯光页面。来源: CarControl 应用跳转 Intent 规范。部署: 合并进执行器 filesDir/registry.json (或单独部署时把 servicePackage/serviceClass 留空)。",
  "app": "com.immotors.carcontrol",
  "intentScreens": {
    "pkg": "com.immotors.carcontrol",
    "byDisplay": {
      "DRIVER": "com.immotors.carcontrol.MainActivity",
      "PASSENGER": "com.immotors.carcontrol.GuestScreenActivity",
      "REAR": "com.immotors.carcontrol.RearScreenActivity"
    }
  },
  "tools": [
    { "id": "open_air_front_page",   "mechanism": "intent", "extras": [{ "key": "ToCarControl", "fromArgs": true }], "args": { "type": "air",   "subTabName": "frontSeat" }, "displayDefault": "DRIVER", "displayArg": "display" },
    { "id": "open_air_rear_page",    "mechanism": "intent", "extras": [{ "key": "ToCarControl", "fromArgs": true }], "args": { "type": "air",   "subTabName": "rearSeat"  }, "displayDefault": "DRIVER", "displayArg": "display" },
    { "id": "open_seat_heat_page",   "mechanism": "intent", "extras": [{ "key": "ToCarControl", "fromArgs": true }], "args": { "type": "seat",  "subTabName": "heatVent"  }, "displayDefault": "DRIVER", "displayArg": "display" },
    { "id": "open_seat_massage_page","mechanism": "intent", "extras": [{ "key": "ToCarControl", "fromArgs": true }], "args": { "type": "seat",  "subTabName": "massage"   }, "displayDefault": "DRIVER", "displayArg": "display" },
    { "id": "open_seat_mode_page",   "mechanism": "intent", "extras": [{ "key": "ToCarControl", "fromArgs": true }], "args": { "type": "seat",  "subTabName": "mode"      }, "displayDefault": "DRIVER", "displayArg": "display" },
    { "id": "open_seat_position_page","mechanism": "intent", "extras": [{ "key": "ToCarControl", "fromArgs": true }], "args": { "type": "seat",  "subTabName": "position"  }, "displayDefault": "DRIVER", "displayArg": "display" },
    { "id": "open_light_page",       "mechanism": "intent", "extras": [{ "key": "ToCarControl", "fromArgs": true }], "args": { "type": "light" },                                 "displayDefault": "DRIVER", "displayArg": "display" }
  ]
}
