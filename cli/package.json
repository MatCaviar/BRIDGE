{
  "name": "@im/mcp-pipeline-cli",
  "version": "0.1.0",
  "description": "CLI tool for MCP Server generation pipeline",
  "type": "module",
  "bin": {
    "mcp-pipeline": "./bin/mcp-pipeline.js"
  },
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build --prefix ../framework",
    "check-manifests": "node ../scripts/check-manifests.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "@im/mcp-server-framework": "file:../framework",
    "ajv": "^8.17.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "zod": "^3.24.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
