{
  "app": {
    "name": "collision-test",
    "domain": "cockpit",
    "framework": "YunOS HDT",
    "entryFile": "src/index.ts"
  },
  "capabilities": [
    {
      "id": "read_vehicle_speed",
      "domain": "vehicle",
      "object": "speed",
      "action": "read",
      "params": [],
      "returns": { "type": "SpeedResult", "fields": ["success", "value"] },
      "safetyLevel": "readonly",
      "sdkCalls": ["@system.vehicle"],
      "sourceRef": "src/services/vehicle.ts:readSpeed"
    },
    {
      "id": "read_engine_rpm",
      "domain": "vehicle",
      "object": "rpm",
      "action": "read",
      "params": [],
      "returns": { "type": "RpmResult", "fields": ["success", "value"] },
      "safetyLevel": "readonly",
      "sdkCalls": ["@system.vehicle"],
      "sourceRef": "src/services/vehicle.ts:readRpm"
    },
    {
      "id": "read_fuel_level",
      "domain": "vehicle",
      "object": "fuel",
      "action": "read",
      "params": [],
      "returns": { "type": "FuelResult", "fields": ["success", "percentage"] },
      "safetyLevel": "readonly",
      "sdkCalls": ["@system.vehicle"],
      "sourceRef": "src/services/vehicle.ts:readFuel"
    },
    {
      "id": "set_light_front",
      "domain": "light",
      "object": "light",
      "action": "set_front",
      "params": [{ "name": "brightness", "type": "number" }],
      "returns": { "type": "LightResult", "fields": ["success", "brightness"] },
      "safetyLevel": "normal",
      "sdkCalls": ["@system.light"],
      "sourceRef": "src/services/light.ts:setFront"
    },
    {
      "id": "set_light_rear",
      "domain": "light",
      "object": "light",
      "action": "set_rear",
      "params": [{ "name": "brightness", "type": "number" }],
      "returns": { "type": "LightResult", "fields": ["success", "brightness"] },
      "safetyLevel": "normal",
      "sdkCalls": ["@system.light"],
      "sourceRef": "src/services/light.ts:setRear"
    }
  ]
}
