      "values": ["AllCar", "Driver", "RearSeatVip", "HignOrderSurround", "MiniConcert", "ConcertHall", "ProfessionalListeningRoom", "Custom", "PanoramicCinema", "AIRhineVoice", "AIAuroraWarm", "AIEnglandStyle", "AIAmericanMetal"],
