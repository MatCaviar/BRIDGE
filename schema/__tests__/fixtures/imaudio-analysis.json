    "entryFile": "ts/App.ts",
    "pages": ["home", "soundSpace"],
    "permissions": [
      "MANAGE_VOICE_KEYPHRASES.permission.yunos.com",
      "APR_HIDDEN_TRIGGER.permission.yunos.com",
      "NETWORK.permission.yunos.com",
      "GLOBAL_GESTURE.permission.yunos.com",
      "IMAUDIO_SERVICE.permission.yunos.com",
      "CREATE_OVERLAY_WINDOW.permission.yunos.com",
      "MEDIA_SERVICE.permission.yunos.com",
      "MODIFY_AUDIO_SETTINGS.permission.yunos.com",
      "CAR_INFO.permission.yunos.com",
      "CAR_PROPERTY_SYS.permission.yunos.com",
      "SPEECH_RECOGNITION.permission.yunos.com",
      "PLAY_TTS.permission.yunos.com",
      "CAR_CONTROL_AMBIENT_LIGHT.permission.yunos.com",
      "CAR_CONTROL_WINDOW.permission.yunos.com",
      "NETMGR_URL_GET.permission.yunos.com"
    ],
    "voiceEnabled": true,
    "dualScreen": true
