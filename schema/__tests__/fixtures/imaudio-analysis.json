        { "name": "fade", "type": "number", "optional": true },
        { "name": "balance", "type": "number", "optional": true }
      ],
      "returns": {
        "type": "SoundStageResult",
        "fields": ["success", "mode", "fade", "balance"]
      },
      "safetyLevel": "normal",
      "sdkCalls": ["SoundStageManager.setSoundStage"],
      "sourceRef": "ts/model/SoundStageModel.ts:setSoundStage"
