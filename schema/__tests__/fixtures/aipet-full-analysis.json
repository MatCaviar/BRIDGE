{
  "app": {
    "name": "aipet",
    "domain": "cockpit",
    "framework": "YunOS HDT",
    "entryFile": "ts/AipetApp.ts",
    "pages": ["home", "photo", "phone", "loading", "result", "setting"],
    "permissions": ["system.router", "system.network", "system.camera", "system.bluetooth", "system.vehicle"],
    "voiceEnabled": true,
    "dualScreen": true
  },
  "capabilities": [
    {
      "id": "navigate_to",
      "domain": "navigation",
      "object": "page",
      "action": "navigate_to",
      "params": [
        { "name": "pageName", "type": "string", "enum": ["home", "photo", "phone", "loading", "result", "setting"] }
      ],
      "returns": { "type": "NavigationResult", "fields": ["success", "currentPage"] },
      "safetyLevel": "normal",
      "sdkCalls": ["yunos/appmodel/StackRouter"],
      "sourceRef": "ts/presenter/HomePresenter.ts:navigate"
    },
    {
      "id": "go_back",
      "domain": "navigation",
      "object": "page",
      "action": "go_back",
      "params": [],
      "returns": { "type": "NavigationResult", "fields": ["success", "currentPage"] },
      "safetyLevel": "normal",
      "sdkCalls": ["yunos/appmodel/StackRouter"],
      "sourceRef": "ts/presenter/HomePresenter.ts:goBack"
    },
    {
      "id": "get_current_page",
      "domain": "navigation",
      "object": "page",
      "action": "get_current",
      "params": [],
      "returns": { "type": "CurrentPageResult", "fields": ["success", "currentPage", "stackDepth"] },
      "safetyLevel": "readonly",
      "sdkCalls": ["yunos/appmodel/StackRouter"],
      "sourceRef": "ts/presenter/BasePresenter.ts:getCurrentPage"
    },
    {
      "id": "capture_photo",
      "domain": "pet",
      "object": "pet",
      "action": "capture",
      "params": [
        { "name": "fps", "type": "number" }
      ],
      "returns": { "type": "CaptureResult", "fields": ["success", "imagePath"] },
      "safetyLevel": "p_gear_required",
      "sdkCalls": ["IMCameraProxy.executeCmd"],
      "sourceRef": "src/proxy/IMCameraProxy.js:capturePhoto"
    },
    {
      "id": "upload_pet_image",
      "domain": "pet",
      "object": "pet_image",
      "action": "upload",
      "params": [
        { "name": "imagePath", "type": "string" }
      ],
      "returns": { "type": "UploadResult", "fields": ["success", "uploadedUrl"] },
      "safetyLevel": "p_gear_required",
      "sdkCalls": ["yunos/net/HttpClient"],
      "sourceRef": "ts/presenter/PhonePresenter.ts:uploadImage"
    },
    {
      "id": "generate_pet_avatar",
      "domain": "pet",
      "object": "pet_avatar",
      "action": "generate",
      "params": [
        { "name": "style", "type": "string", "enum": ["cartoon", "realistic", "sketch", "anime"] },
        { "name": "imagePath", "type": "string" }
      ],
      "returns": { "type": "GenerateResult", "fields": ["success", "avatarUrl"] },
      "safetyLevel": "p_gear_required",
      "sdkCalls": ["yunos/net/HttpClient"],
      "sourceRef": "ts/presenter/LoadingPresenter.ts:generateAvatar"
    },
    {
      "id": "apply_pet_avatar",
      "domain": "pet",
      "object": "pet_avatar",
      "action": "apply",
      "params": [
        { "name": "avatarUrl", "type": "string" },
        { "name": "scene", "type": "string", "enum": ["screensaver", "avatar", "desktop_card"] },
        { "name": "confirmed", "type": "boolean" }
      ],
      "returns": { "type": "ApplyResult", "fields": ["success"] },
      "safetyLevel": "p_gear_and_confirm",
      "sdkCalls": ["@banma/hdt-types"],
      "sourceRef": "ts/presenter/ResultPresenter.ts:applyAvatar"
    },
    {
      "id": "regenerate_pet_avatar",
      "domain": "pet",
      "object": "pet_avatar",
      "action": "regenerate",
      "params": [
        { "name": "style", "type": "string", "enum": ["cartoon", "realistic", "sketch", "anime"] }
      ],
      "returns": { "type": "GenerateResult", "fields": ["success", "avatarUrl"] },
      "safetyLevel": "p_gear_required",
      "sdkCalls": ["yunos/net/HttpClient"],
      "sourceRef": "ts/presenter/ResultPresenter.ts:regenerateAvatar"
    },
    {
      "id": "get_vehicle_info",
      "domain": "vehicle",
      "object": "vehicle",
      "action": "get_info",
      "params": [],
      "returns": { "type": "VehicleInfoResult", "fields": ["success", "vin"] },
      "safetyLevel": "readonly",
      "sdkCalls": ["sysprop/sysprop"],
      "sourceRef": "src/proxy/BaseProxy.js:getVehicleInfo"
    },
    {
      "id": "get_gear_status",
      "domain": "vehicle",
      "object": "gear",
      "action": "read_status",
      "params": [],
      "returns": { "type": "GearStatus", "fields": ["success", "isParked", "ignoreMode", "rawValue"] },
      "safetyLevel": "readonly",
      "sdkCalls": ["yunos/platform/auto/carservice/CarPropertyManager"],
      "sourceRef": "ts/manager/CarManager.ts:getGearStatus"
    },
    {
      "id": "on_gear_changed",
      "domain": "vehicle",
      "object": "gear",
      "action": "subscribe",
      "params": [],
      "returns": { "type": "GearChangeResult", "fields": ["success", "isParked", "gearValue"] },
      "safetyLevel": "readonly",
      "sdkCalls": ["yunos/platform/auto/carservice/CarPropertyManager"],
      "sourceRef": "ts/manager/CarManager.ts:subscribeGear"
    },
    {
      "id": "get_hotspot_info",
      "domain": "transfer",
      "object": "hotspot",
      "action": "get_info",
      "params": [],
      "returns": { "type": "HotspotInfoResult", "fields": ["success", "ssid"] },
      "safetyLevel": "readonly",
      "sdkCalls": ["yunos/net/HotspotManager"],
      "sourceRef": "ts/presenter/PhonePresenter.ts:getHotspot"
    },
    {
      "id": "generate_qr_code",
      "domain": "transfer",
      "object": "qr_code",
      "action": "generate",
      "params": [
        { "name": "data", "type": "string" }
      ],
      "returns": { "type": "QrCodeResult", "fields": ["success", "qrCodeUrl"] },
      "safetyLevel": "readonly",
      "sdkCalls": ["yunos/net/HttpClient"],
      "sourceRef": "ts/presenter/PhonePresenter.ts:generateQR"
    },
    {
      "id": "transfer_to_phone",
      "domain": "transfer",
      "object": "phone",
      "action": "transfer",
      "params": [
        { "name": "data", "type": "string" },
        { "name": "ssid", "type": "string" }
      ],
      "returns": { "type": "TransferResult", "fields": ["success", "status"] },
      "safetyLevel": "p_gear_and_network",
      "sdkCalls": ["yunos/net/HotspotManager", "yunos/net/HttpClient"],
      "sourceRef": "ts/presenter/PhonePresenter.ts:transferToPhone"
    },
    {
      "id": "get_app_status",
      "domain": "system",
      "object": "app",
      "action": "get_status",
      "params": [],
      "returns": { "type": "AppStatusResult", "fields": ["success", "currentPage", "isDualScreen"] },
      "safetyLevel": "readonly",
      "sdkCalls": ["extend/hdt/page/BMPage"],
      "sourceRef": "ts/AipetApp.ts:getAppStatus"
    },
    {
      "id": "get_display_info",
      "domain": "system",
      "object": "display",
      "action": "get_info",
      "params": [],
      "returns": { "type": "DisplayInfoResult", "fields": ["success", "displayName"] },
      "safetyLevel": "readonly",
      "sdkCalls": ["extend/hdt/page/BMPage"],
      "sourceRef": "ts/AipetApp.ts:getDisplayInfo"
    },
    {
      "id": "show_toast",
      "domain": "system",
      "object": "toast",
      "action": "show",
      "params": [
        { "name": "message", "type": "string" },
        { "name": "align", "type": "string", "enum": ["top", "center", "bottom"], "optional": true }
      ],
      "returns": { "type": "ToastResult", "fields": ["success"] },
      "safetyLevel": "normal",
      "sdkCalls": ["yunos/ui/widget/Toast"],
      "sourceRef": "ts/utils/ToastUtils.ts:show"
    },
    {
      "id": "show_loading",
      "domain": "system",
      "object": "loading",
      "action": "show",
      "params": [
        { "name": "message", "type": "string", "optional": true }
      ],
      "returns": { "type": "LoadingResult", "fields": ["success"] },
      "safetyLevel": "normal",
      "sdkCalls": ["yunos/ui/animation/PropertyAnimation"],
      "sourceRef": "ts/utils/LoadingUtils.ts:start"
    },
    {
      "id": "hide_loading",
      "domain": "system",
      "object": "loading",
      "action": "hide",
      "params": [],
      "returns": { "type": "LoadingResult", "fields": ["success"] },
      "safetyLevel": "normal",
      "sdkCalls": ["yunos/ui/animation/PropertyAnimation"],
      "sourceRef": "ts/utils/LoadingUtils.ts:stop"
    },
    {
      "id": "play_animation",
      "domain": "system",
      "object": "animation",
      "action": "play",
      "params": [
        { "name": "type", "type": "string" },
        { "name": "duration", "type": "number", "optional": true }
      ],
      "returns": { "type": "AnimationResult", "fields": ["success"] },
      "safetyLevel": "normal",
      "sdkCalls": ["yunos/ui/view/ImageView"],
      "sourceRef": "ts/presenter/LoadingPresenter.ts:playAnimation"
    }
  ],
  "enums": {
    "PageName": {
      "values": ["home", "photo", "phone", "loading", "result", "setting"],
      "type": "string",
      "sourceFile": "ts/type/Enum.ts"
    },
    "DisplayName": {
      "values": ["disp_host0", "disp_guest0"],
      "type": "string",
      "sourceFile": "ts/type/Enum.ts"
    },
    "GearPosition": {
      "values": ["P", "R", "N", "D"],
      "type": "string",
      "sourceFile": "ts/manager/CarManager.ts"
    },
    "AvatarStyle": {
      "values": ["cartoon", "realistic", "sketch", "anime"],
      "type": "string",
      "sourceFile": "ts/presenter/LoadingPresenter.ts"
    },
    "ApplyScene": {
      "values": ["screensaver", "avatar", "desktop_card"],
      "type": "string",
      "sourceFile": "ts/presenter/ResultPresenter.ts"
    },
    "TransferStatus": {
      "values": ["pending", "completed", "failed"],
      "type": "string",
      "sourceFile": "ts/presenter/PhonePresenter.ts"
    }
  },
  "errorCodes": {
    "nav": {
      "prefix": 1,
      "domainName": "navigation",
      "codes": {
        "PAGE_NOT_FOUND": { "value": 1, "message": "页面不存在" },
        "STACK_OVERFLOW": { "value": 2, "message": "导航栈溢出" },
        "ALREADY_ON_PAGE": { "value": 3, "message": "已在目标页面" }
      }
    },
    "pet": {
      "prefix": 2,
      "domainName": "pet",
      "codes": {
        "CAPTURE_FAILED": { "value": 1, "message": "拍照失败" },
        "UPLOAD_FAILED": { "value": 2, "message": "上传失败" },
        "GENERATE_FAILED": { "value": 3, "message": "生成失败" },
        "APPLY_FAILED": { "value": 4, "message": "应用失败" }
      }
    },
    "vehicle": {
      "prefix": 3,
      "domainName": "vehicle",
      "codes": {
        "SENSOR_UNAVAILABLE": { "value": 1, "message": "传感器不可用" },
        "GEAR_READ_FAILED": { "value": 2, "message": "档位读取失败" }
      }
    },
    "transfer": {
      "prefix": 4,
      "domainName": "transfer",
      "codes": {
        "HOTSPOT_UNAVAILABLE": { "value": 1, "message": "热点不可用" },
        "QR_GENERATE_FAILED": { "value": 2, "message": "二维码生成失败" },
        "TRANSFER_FAILED": { "value": 3, "message": "传输失败" }
      }
    },
    "system": {
      "prefix": 5,
      "domainName": "system",
      "codes": {
        "DISPLAY_ERROR": { "value": 1, "message": "显示异常" },
        "ANIMATION_ERROR": { "value": 2, "message": "动画播放失败" },
        "APP_NOT_READY": { "value": 3, "message": "应用未就绪" }
      }
    }
  }
}
